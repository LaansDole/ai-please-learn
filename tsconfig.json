{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "lib": ["ES2022", "ES2024.Promise", "DOM", "DOM.Iterable"],
    "strict": true, "noUnusedLocals": true, "noUnusedParameters": true, "noFallthroughCasesInSwitch": true,
    "isolatedModules": true, "verbatimModuleSyntax": true, "skipLibCheck": true, "noEmit": true,
    "types": ["vite/client", "node"]
  },
  "include": ["src", "tests", "tools", "vite.config.ts", "vitest.config.ts", "vitest.bench.config.ts", "playwright.config.ts"]
}
