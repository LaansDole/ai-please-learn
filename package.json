{
  "name": "evolab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "bench": "vitest run --config vitest.bench.config.ts tests/bench",
    "perf": "vitest run --config vitest.bench.config.ts tests/perf",
    "e2e": "playwright test",
    "llm-trial": "node -e \"import('vite').then((v) => v.runnerImport('./scripts/llm-trial.ts', { configFile: false })).catch((e) => { console.error(e); process.exit(1); })\" --"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "@types/three": "0.187.0",
    "fake-indexeddb": "6.2.8",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "three": "0.187.0"
  }
}
